# Copy to .env. Every provider is optional; unset ones show under "Not connected".
PORT=4317

# Anthropic API (organization accounts only). Admin key: Console > Settings > Admin keys.
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_MONTHLY_BUDGET_USD=

# OpenAI API. Admin key: platform settings > Admin keys.
OPENAI_ADMIN_KEY=
OPENAI_MONTHLY_BUDGET_USD=

# GitHub Copilot (personal plan). Token needs the user "Plan" read permission.
GITHUB_TOKEN=
GITHUB_USERNAME=
# pro | pro_plus | max, or set an exact number of included credits instead.
COPILOT_PLAN=
COPILOT_CREDIT_LIMIT=

# Cursor (Team/Enterprise only). Admin key from the team dashboard.
CURSOR_ADMIN_KEY=
CURSOR_EMAIL=
CURSOR_MONTHLY_BUDGET_USD=

# GLM Coding Plan (Z.ai). The plan's API key. ZAI_REGION=cn for open.bigmodel.cn.
ZAI_API_KEY=
ZAI_REGION=

# Claude Pro/Max: no key. CLAUDE_USAGE_CLI=on runs Claude Code's own /usage for live numbers
# (set by npm run connect); otherwise the status-line capture is used.
CLAUDE_USAGE_CLI=off
CLAUDE_BIN=
CLAUDE_STATUSLINE_FILE=

# ChatGPT Plus/Pro: reads the Codex CLI's ChatGPT login (read-only). Unofficial.
CHATGPT_USAGE=off
CODEX_HOME=

# Gemini (AI Pro/Ultra/free): runs the Antigravity CLI. Unofficial output format.
GEMINI_AGY=off
AGY_BIN=
